// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`progressive face gold — stream mode three states (component segments) > 全量 final: rows in, loading row gone, .final on the root; missing key falls back to empty cell > stream-full-final 1`] = `"<div class="streaming-table final"=""><table><thead><tr><th>名称</th><th>数量</th></tr></thead><tbody><tr><td>甲</td><td>一</td></tr><tr><td>乙</td><td></td></tr></tbody></table></div>"`;

exports[`progressive face gold — stream mode three states (component segments) > 列头先行: header renders before any row; loading row spans the column count > stream-header-first 1`] = `"<div class="streaming-table"><table><thead><tr><th>名称</th><th>数量</th></tr></thead><tbody><tr class="loading-row"><td colspan="2"><span class="loading-dots">Loading</span></td></tr></tbody></table></div>"`;

exports[`progressive face gold — stream mode three states (component segments) > 空: nullish props fall through the normalization to the empty table + loading row > stream-empty 1`] = `"<div class="streaming-table"><table><thead><tr></tr></thead><tbody><tr class="loading-row"><td colspan="1"><span class="loading-dots">Loading</span></td></tr></tbody></table></div>"`;

exports[`terminal face gold — the view mode through the real pipe (.table-node contract) > closed (final): full table with resize handles and embedded cell renderers > terminal-closed 1`] = `"<div class="markdown-renderer"><div class="node-slot" data-node-index="0" data-node-type="table"><div class="node-content"><table aria-busy="false" class="table-node"><thead><tr><th class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>名称</span></span><button class="table-node__resize-handle" type="button"></button></th><th class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>值</span></span><button class="table-node__resize-handle" type="button"></button></th></tr></thead><tbody><tr><td class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>甲</span></span></td><td class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>1</span></span></td></tr><tr><td class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>乙</span></span></td><td class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>2</span></span></td></tr></tbody></table></div></div></div>"`;

exports[`terminal face gold — the view mode through the real pipe (.table-node contract) > open (mid-stream): header + first row already in the .table-node contract > terminal-open 1`] = `"<div class="markdown-renderer"><div class="node-slot" data-node-index="0" data-node-type="table"><div class="node-content"><table aria-busy="false" class="table-node"><thead><tr><th class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>名称</span></span><button class="table-node__resize-handle" type="button"></button></th><th class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>值</span></span><button class="table-node__resize-handle" type="button"></button></th></tr></thead><tbody><tr><td class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>甲</span></span></td><td class="text-left" dir="auto"><span break-words="" class="whitespace-pre-wrap text-node"=""><span>1</span></span></td></tr></tbody></table></div></div></div>"`;
