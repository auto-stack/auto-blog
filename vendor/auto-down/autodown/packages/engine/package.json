{
  "name": "@autodown/engine",
  "version": "0.5.0",
  "description": "AutoDown unified document engine — parser / render / editor in one package (plan 017; contract freeze in plan 020; version 0.5.0 per 2026-08-28 version policy — 1.0 reserved for the language as a whole)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./parser": {
      "development": "./src/parser.ts",
      "import": "./dist/parser.js",
      "types": "./dist/parser.d.ts"
    },
    "./render": {
      "development": "./src/render.ts",
      "import": "./dist/render.js",
      "types": "./dist/render.d.ts"
    },
    "./editor": {
      "development": "./src/editor.ts",
      "import": "./dist/editor.js",
      "types": "./dist/editor.d.ts"
    },
    "./style.css": {
      "development": "./src/editor/styles/autodown-editor.css",
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./parser": {
        "import": "./dist/parser.js",
        "types": "./dist/parser.d.ts"
      },
      "./render": {
        "import": "./dist/render.js",
        "types": "./dist/render.d.ts"
      },
      "./editor": {
        "import": "./dist/editor.js",
        "types": "./dist/editor.d.ts"
      },
      "./style.css": {
        "default": "./dist/style.css"
      }
    }
  },
  "scripts": {
    "build": "vue-tsc -b && vite build && node scripts/assert-parser-pure.mjs && node scripts/assert-no-tiptap.mjs && node scripts/assert-editor-gen.mjs && node scripts/write-dist-stamp.mjs",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "gen:parser": "node auto/parser/gen.mjs",
    "gen:render": "node auto/render/gen.mjs",
    "gen:editor": "node auto/editor/gen.mjs"
  },
  "peerDependencies": {
    "lucide-vue-next": "^0.460.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "hast-util-to-html": "9.0.5",
    "katex": "^0.16.0",
    "lowlight": "^3.3.0",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/server-renderer": "^3.5.35",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.12.0",
    "lucide-vue-next": "^0.460.0",
    "stream-markdown-parser": "0.0.95",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.7",
    "vue": "^3.4.0",
    "vue-tsc": "^3.3.8"
  }
}
