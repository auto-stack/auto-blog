// app.at — App shell. Routes + top nav + outlet.
// BLOG-001：默认进个人作者（/）；社区 demo 独立入口（/demo）。
// Nav adapts to login state (.store.me.id != 0 = logged in).
use auth_store: AuthStore
use article_store: ArticleStore
use draft_store: DraftStore

// PLAN-637 B5 Phase B 映射（灰阶分层口径）：gray-800/700/600→foreground；gray-500/400→
// muted-foreground；border-gray-N→border-border；bg-white→bg-card；bg-gray-100→bg-muted；
// bg-red-50/text-red-500→destructive 族。text-white ×5 为 brand-green 品牌按钮配对字
// （品牌绿=本 demo 自定义语义色，整体豁免保留）。表单输入框 ×13 消费 stylekit
// input_field（D1 家族源 demo）。
widget App {
    routes {
        "/" -> use author
        "/demo" -> use home
        "/login" -> use login
        "/register" -> use register
        "/article/:slug" -> use article_detail
        "/settings" -> use settings
        "/editor/:slug" -> use editor
        "/profile/:username" -> use profile
    }

    msg { Init, Logout, GoProfile(str), GoAuthor, GoDemo }

    view {
        col {
            style: "min-h-screen font-serif text-foreground"
            // Top nav
            row {
                style: "w-full border-b border-border px-4 py-3 max-w-3xl mx-auto items-center gap-4"
                link (to: "/") {
                    text "auto-blog" { style: "text-brand-green text-xl font-bold no-underline" }
                }
                row {
                    style: "ml-auto gap-4 text-sm items-center"
                    link (to: "/") { text "我的草稿" { style: "text-foreground" } }
                    link (to: "/demo") { text "社区Demo" { style: "text-muted-foreground" } }
                    if .store.me != nil {
                        if .store.me.id != 0 {
                            link (to: "/editor/new") { text "New Post" { style: "text-muted-foreground" } }
                            link (to: "/settings") { text "Settings" { style: "text-muted-foreground" } }
                            text .store.me.username {
                                onclick: .GoProfile(.store.me.username)
                                style: "text-foreground cursor-pointer"
                            }
                        } else {
                            link (to: "/login") { text "Sign in" { style: "text-muted-foreground" } }
                            link (to: "/register") { text "Sign up" { style: "text-muted-foreground" } }
                        }
                    } else {
                        link (to: "/login") { text "Sign in" { style: "text-muted-foreground" } }
                        link (to: "/register") { text "Sign up" { style: "text-muted-foreground" } }
                    }
                }
            }
            // Route outlet
            col {
                outlet
            }
        }
    }

    on {
        .Init -> {
            // 多 store 裸 `store.Init()` 歧义（Auth/Article 均有 Init）——
            // VM 渲染按 plan-446 A1 拒绝歧义调用；限定到意图归属：
            // 会话恢复归 AuthStore，Feed 加载归 ArticleStore（其 LoadFeed
            // 专名即为此设计，见 article_store.at 注）。
            AuthStore.Init()
            ArticleStore.LoadFeed()
        }
        .Logout -> {
            AuthStore.Logout()
            ArticleStore.SetToken("")
        }
        .GoProfile(username str) -> { router.push("/profile/" + username) }
        .GoAuthor -> { router.push("/") }
        .GoDemo -> { router.push("/demo") }
    }
}
