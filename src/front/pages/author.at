// pages/author.at — BLOG-001 个人作者入口（默认）。
// 列表 + 写作；不依赖 demo 登录。demo 社区经独立入口。
// BLOG-002 T-01：正文区 = Markdown 引擎/纯文本降级写作面（内联于本件）+ 封面输入。
// 写作面不拆子件：VM 轨对 `use <module>: <Widget>` 子件实例化静默失败（F-6，
// 同目录/调用式均不复现 auto-notes 的单层结构），内联保证双轨同构；vue 轨
// 行为不变（同一视图树）。
use draft_store: DraftStore
use stylekit.styles: input_field

widget author {
    msg {
        Init, AutosaveTick, GoNew, GoOpen(str), TitleChanged(str),
        SummaryChanged(str), TagsChanged(str), CoverChanged(str), DoSave,
        KeepMine, KeepTheirs, GoDemo, ToggleEngine, FormatText, FormatMd,
        AssetRefInput(str), AssetCaptionInput(str), AddAsset, ImportItems(str), DoCompose,
        PreviewOpen, PreviewClose
    }

    model {
        // 写作面形态（视图本地态，不落盘）：use_engine=用户引擎偏好；
        // force_engine=空稿起稿后显式请求进入引擎（仅正文非空时可用）。
        var use_engine bool = true
        var force_engine bool = false
        // T-02 输入缓冲（视图本地态）
        var asset_ref_input str = ""
        var asset_caption_input str = ""
        var import_items str = ""
        // T-03 预览状态（可返回的独立状态；不覆盖编辑内容）
        var preview_open bool = false
    }

    timer {
        AutosaveTick (every_ms: 3000)
    }

    view {
        col {
            style: "max-w-3xl mx-auto px-4 py-6 gap-4"
            row {
                style: "items-center justify-between"
                row {
                    style: "items-center gap-2"
                    text "我的草稿" { style: "text-2xl font-semibold" }
                    text "个人模式" {
                        style: "text-xs px-2 py-0.5 rounded bg-muted text-muted-foreground border border-border"
                    }
                }
                row {
                    style: "gap-3 text-sm items-center"
                    button "新建草稿" {
                        onclick: .GoNew,
                        style: "px-3 py-1.5 rounded bg-brand-green text-white text-sm"
                    }
                    text "社区 Demo →" {
                        onclick: .GoDemo,
                        style: "text-muted-foreground cursor-pointer hover:underline"
                    }
                }
            }

            if .store.save_state == "dirty" {
                text "● 未保存" { style: "text-amber-600 text-xs" }
            }
            if .store.save_state == "saving" {
                text "○ 保存中…" { style: "text-muted-foreground text-xs" }
            }
            if .store.save_state == "saved" {
                text "● 已保存" { style: "text-green-600 text-xs" }
            }
            if .store.save_state == "error" {
                text f"保存失败：${.store.error}" {
                    style: "text-destructive text-xs bg-destructive/10 rounded p-2"
                }
            }
            if .store.save_state == "conflict" {
                col {
                    style: "gap-2 border border-amber-400 bg-amber-50 rounded p-3 text-sm"
                    text f"保存冲突：${.store.error}"
                    row {
                        style: "gap-2"
                        button "保留本机版本" {
                            onclick: .KeepMine,
                            style: "px-3 py-1 rounded bg-brand-green text-white text-xs"
                        }
                        button "加载对方版本" {
                            onclick: .KeepTheirs,
                            style: "px-3 py-1 rounded border border-border text-xs"
                        }
                    }
                }
            }

            row {
                // 响应式（T-03/AC-05）：窄屏纵排（侧栏全宽在上、编辑区不被挤占），
                // ≥md 恢复横排。VM 轨 class 惰性，桌面窗口布局不变。
                style: "gap-6 items-start flex-col md:flex-row"
                col {
                    style: "w-full md:w-56 shrink-0 gap-1"
                    text "草稿" { style: "text-sm font-medium text-muted-foreground mb-1" }
                    if .store.drafts.len() == 0 {
                        text "暂无草稿" { style: "text-xs text-muted-foreground" }
                    }
                    for d in .store.drafts {
                        col {
                            style: "px-2 py-1.5 rounded hover:bg-muted cursor-pointer gap-0.5"
                            onclick: .GoOpen(d.work_id)
                            text d.title { style: "text-sm truncate" }
                            text f"rev ${d.revision}" { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
                col {
                    // 窄屏换行（T-03/AC-05）：min-w 强制 flex-wrap 把编辑区折到
                    // 侧栏下方全宽展示——主编辑区不被边栏挤占，草稿列表仍可达。
                    // VM 轨未知 class 惰性，桌面窗口布局不受影响。
                    style: "flex-1 gap-3 min-w-0 max-w-full overflow-hidden"
                    if .store.has_current == false {
                        col {
                            style: "items-center py-16 text-muted-foreground gap-2"
                            text "选择或新建一篇草稿"
                            text "未登录即可创作，草稿保存在本机" { style: "text-sm" }
                        }
                    } else {
                        if .store.save_state == "error" {
                            text f"错误：${.store.error}（正文保留在编辑器）" {
                                style: "text-destructive text-xs bg-destructive/10 rounded p-2"
                            }
                        }
                        input {
                            placeholder: "文章标题",
                            value: .store.editing_title,
                            oninput: .TitleChanged($event),
                            style: "w-full px-3 py-2 border border-border rounded text-xl"
                        }
                        input {
                            placeholder: "摘要（可选）",
                            value: .store.editing_summary,
                            oninput: .SummaryChanged($event),
                            style: input_field
                        }
                        // ── 预览（T-03）：可返回的独立状态；本地渲染离线可用；
                        // 未识别语法按原文显示；不执行文章脚本（引擎组件化渲染）。
                        if .preview_open {
                            col {
                                style: "gap-2 border border-border rounded p-3"
                                row {
                                    style: "gap-2 items-center"
                                    text "本地预览（离线可用）" {
                                        style: "text-xs font-medium text-brand-green"
                                    }
                                    text "未识别语法按原文显示" {
                                        style: "text-xs text-muted-foreground"
                                    }
                                }
                                if .store.asset_report != "" {
                                    text .store.asset_report {
                                        style: "text-xs text-amber-700 bg-amber-50 rounded p-2"
                                    }
                                }
                                autodown {
                                    content: .store.editing_body,
                                    class: "min-h-32"
                                }
                            }
                        }
                        if .preview_open == false {
                        // ── 写作面（Markdown 引擎 / 纯文本降级，T-01）──────────
                        // 格式行：text 稿（BLOG-001 存量）恒 textarea；
                        // markdown 稿：打开时正文非空默认引擎，空稿先 textarea
                        // 起稿（引擎空文档 0 块不可输入——T-01 实证），正文
                        // 非空后「切引擎」点亮；分支只随采纳/显式切换翻转。
                        row {
                            style: "gap-2 items-center"
                            if .store.editing_format == "markdown" {
                                button "格式：Markdown · 切纯文本" {
                                    onclick: .FormatText,
                                    style: "px-2 py-1 rounded border border-border text-xs"
                                }
                            } else {
                                button "格式：纯文本 · 切Markdown" {
                                    onclick: .FormatMd,
                                    style: "px-2 py-1 rounded border border-border text-xs"
                                }
                            }
                            if .store.editing_format == "markdown" {
                                if .use_engine && (.store.body_was_empty == false || .force_engine) {
                                    button "编辑器：引擎 · 切降级" {
                                        onclick: .ToggleEngine,
                                        style: "px-2 py-1 rounded border border-border text-xs text-muted-foreground"
                                    }
                                } else {
                                    if .store.editing_body != "" {
                                        button "编辑器：降级 · 切引擎" {
                                            onclick: .ToggleEngine,
                                            style: "px-2 py-1 rounded border border-border text-xs text-amber-600"
                                        }
                                    } else {
                                        text "空稿可直接输入；正文非空后可切引擎编辑器" {
                                            style: "text-xs text-muted-foreground"
                                        }
                                    }
                                }
                            }
                        }
                        if .store.editing_format == "markdown" && .use_engine && (.store.body_was_empty == false || .force_engine) {
                            autodown_editor {
                                content: .store.editing_body,
                                placeholder: "正文（Markdown；自动保存）",
                                class: "min-h-[320px] max-w-full overflow-hidden",
                                oninput: .BodyChanged
                            }
                        } else {
                            textarea {
                                value: .store.editing_body,
                                oninput: .BodyChanged,
                                placeholder: "正文（Markdown 语法可直接输入；自动保存）",
                                style: "w-full px-3 py-2 border border-border rounded text-sm min-h-[320px] font-serif"
                            }
                        }
                        }
                        input {
                            placeholder: "标签（逗号分隔）",
                            value: .store.editing_tags,
                            oninput: .TagsChanged($event),
                            style: input_field
                        }
                        input {
                            placeholder: "封面（图片 URL 或资产引用，可选）",
                            value: .store.editing_cover,
                            oninput: .CoverChanged($event),
                            style: input_field
                        }
                        // ── 资产（图片/说明，T-02）──────────────────────
                        row {
                            style: "gap-2 flex-wrap"
                            input {
                                placeholder: "图片引用（URL/路径）",
                                value: .asset_ref_input,
                                oninput: .AssetRefInput($event),
                                style: "flex-1 min-w-0 px-3 py-1.5 border border-border rounded text-sm"
                            }
                            input {
                                placeholder: "图片说明（可选）",
                                value: .asset_caption_input,
                                oninput: .AssetCaptionInput($event),
                                style: "flex-1 min-w-0 px-3 py-1.5 border border-border rounded text-sm"
                            }
                            button "添加图片" {
                                onclick: .AddAsset,
                                style: "px-3 py-1.5 rounded border border-border text-sm"
                            }
                        }
                        // ── 来源导入（Notes/Reader envelope，T-02）────────
                        col {
                            style: "gap-2 border border-border rounded p-3"
                            text "导入资料（粘贴 envelope JSON 数组；显式导入副本，原笔记零写入）" {
                                style: "text-xs text-muted-foreground"
                            }
                            textarea {
                                placeholder: "[{producer:notes, title:标题, body:正文, locator:位置, source_revision:3}]",
                                value: .import_items,
                                oninput: .ImportItems($event),
                                style: "w-full px-3 py-2 border border-border rounded text-xs min-h-[72px] font-mono"
                            }
                            row {
                                style: "justify-between items-center"
                                text "producer+body 必填；mode 缺省 copy（引用=reference 只登记不并入正文）" {
                                    style: "text-xs text-muted-foreground"
                                }
                                button "组合为新作品" {
                                    onclick: .DoCompose,
                                    style: "px-3 py-1.5 rounded bg-brand-green text-white text-sm"
                                }
                            }
                        }
                        row {
                            style: "justify-between items-center"
                            text f"ID ${.store.current.work_id} · rev ${.store.current.revision}" {
                                style: "text-xs text-muted-foreground"
                            }
                            row {
                                style: "gap-2"
                                if .preview_open {
                                    button "返回编辑" {
                                        onclick: .PreviewClose,
                                        style: "px-4 py-1.5 rounded border border-border text-sm"
                                    }
                                } else {
                                    button "预览" {
                                        onclick: .PreviewOpen,
                                        style: "px-4 py-1.5 rounded border border-border text-sm"
                                    }
                                    button "保存" {
                                        onclick: .DoSave,
                                        style: "px-4 py-1.5 rounded bg-brand-green text-white text-sm"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .store.LoadList()
        }
        .AutosaveTick -> {
            .store.AutosaveTick()
        }
        .GoNew -> {
            .store.NewDraft()
            .use_engine = true
            .force_engine = false
        }
        .GoOpen(id str) -> {
            .store.OpenDraft(id)
            .use_engine = true
            .force_engine = false
        }
        .GoDemo -> { router.push("/demo") }
        .TitleChanged(v str) -> { .store.TitleEdit(v) }
        .BodyChanged(v str) -> { .store.BodyEdit(v) }
        .SummaryChanged(v str) -> { .store.SummaryEdit(v) }
        .TagsChanged(v str) -> { .store.TagsEdit(v) }
        .CoverChanged(v str) -> { .store.CoverEdit(v) }
        .DoSave -> { .store.SaveCurrent() }
        .KeepMine -> { .store.ResolveKeepMine() }
        .KeepTheirs -> { .store.ResolveKeepTheirs() }
        .ToggleEngine -> {
            if .use_engine && (.store.body_was_empty == false || .force_engine) {
                .use_engine = false
                .force_engine = false
            } else {
                if .store.editing_body != "" {
                    .use_engine = true
                    .force_engine = true
                }
            }
        }
        .FormatText -> { .store.FormatEdit("text") }
        .FormatMd -> { .store.FormatEdit("markdown") }
        .PreviewOpen -> {
            .preview_open = true
            .store.PreviewCheck()
        }
        .PreviewClose -> { .preview_open = false }
        .AssetRefInput(v str) -> { .asset_ref_input = v }
        .AssetCaptionInput(v str) -> { .asset_caption_input = v }
        .AddAsset -> {
            if .asset_ref_input != "" {
                .store.AddAssetRef(.asset_ref_input, .asset_caption_input)
                .asset_ref_input = ""
                .asset_caption_input = ""
            }
        }
        .ImportItems(v str) -> { .import_items = v }
        .DoCompose -> {
            if .import_items != "" {
                .store.ComposeImport(.import_items)
                .import_items = ""
            }
        }
    }
}
