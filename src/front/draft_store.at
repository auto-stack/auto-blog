// draft_store.at — BLOG-001 个人作者草稿状态（不依赖 demo 登录）。
// Phase 4（R-18/19/20）：初态防护、统一互斥、全量读回校验。
// Phase 5（R-23）：互斥锁覆盖保存+读回+切换全程；每个 await 前后核对编辑序号，
// 等待期编辑一律中止切换并保留本机缓冲；已确认保存推进 current.revision。
// Phase 5（R-24）：普通/强制/切前保存统一为同一全字段读回确认（ID/rev/正文/标题/摘要/标签）。
use back.api: create_draft, open_draft, save_draft, list_drafts, add_asset_ref, import_compose

store DraftStore {
    model {
        var drafts []Work = []
        var current Work = Work { work_id: "", kind: "article", title: "", summary: "", body_format: "text", body: "", tags: "", cover_asset: "", asset_refs: "[]", source_refs: "[]", revision: 1, status: "draft", created_at: 0, updated_at: 0 }
        var has_current bool = false
        var dirty bool = false
        var save_state str = "idle"
        var error str = ""
        var editing_title str = ""
        var editing_body str = ""
        var editing_summary str = ""
        var editing_tags str = ""
        var editing_cover str = ""
        var editing_format str = "text"
        var body_was_empty bool = false
        var edit_seq int = 0
        var save_in_flight bool = false
    }

    msg {
        LoadList, NewDraft, OpenDraft(str), SaveCurrent, ForceSave,
        TitleEdit(str), BodyEdit(str), SummaryEdit(str), TagsEdit(str),
        CoverEdit(str), FormatEdit(str),
        AddAssetRef(str, str), ComposeImport(str),
        AutosaveTick, ResolveKeepMine, ResolveKeepTheirs
    }

    on {
        .LoadList -> {
            .drafts = list_drafts()
        }
        .NewDraft -> {
            // 统一互斥：任何保存/切换进行中不叠操作
            if .save_in_flight {
                .save_state = "error"
                .error = "busy"
            } else {
                var can_create bool = true
                // 切换前先保存未存缓冲；锁覆盖保存+读回（R-23/24）
                if .dirty && .has_current && .current.work_id != "" {
                    .save_in_flight = true
                    .save_state = "saving"
                    let snap_seq int = .edit_seq
                    let snap_id str = .current.work_id
                    let snap_rev int = .current.revision
                    let snap_title str = .editing_title
                    let snap_body str = .editing_body
                    let snap_summary str = .editing_summary
                    let snap_tags str = .editing_tags
                    let snap_cover str = .editing_cover
                    let snap_format str = .editing_format
                    try {
                        let r0 = save_draft(snap_id, snap_title, snap_summary, snap_body, snap_tags, snap_cover, snap_format, snap_rev)
                        if r0.ok {
                            let back = open_draft(snap_id)
                            // 全字段读回确认（R-24：含 summary/tags/cover/format）
                            if back.work_id != snap_id || back.revision != r0.revision || back.body != snap_body || back.title != snap_title || back.summary != snap_summary || back.tags != snap_tags || back.cover_asset != snap_cover || back.body_format != snap_format {
                                can_create = false
                                .save_state = "error"
                                .error = "readback_invalid"
                            } else {
                                // 已确认保存：current 推进到服务器确认版本（R-23）
                                .current = back
                                if .edit_seq == snap_seq {
                                    .dirty = false
                                } else {
                                    // 读回等待期发生编辑：中止切换，保留最新缓冲
                                    can_create = false
                                    .dirty = true
                                    .save_state = "dirty"
                                    .error = ""
                                }
                            }
                        } else {
                            can_create = false
                            if r0.conflict {
                                .save_state = "conflict"
                                .error = "conflict rev " + r0.revision.to_string()
                            } else {
                                .save_state = "error"
                                .error = "save_before_new_failed"
                            }
                        }
                        .save_in_flight = false
                    } catch {
                        .save_in_flight = false
                        can_create = false
                        .save_state = "error"
                        .error = "save_before_new_failed"
                    }
                }
                if can_create {
                    .save_in_flight = true
                    let pre_seq int = .edit_seq
                    try {
                        let nw = create_draft("未命名草稿", "", "markdown")
                        if .edit_seq != pre_seq {
                            // 创建等待期发生编辑：放弃采纳新稿，保留本机缓冲（R-23）
                            .save_in_flight = false
                            .dirty = true
                            .save_state = "dirty"
                        } else {
                            .save_in_flight = false
                            if nw.work_id == "" {
                                .save_state = "error"
                                .error = "create_failed"
                            } else {
                                .current = nw
                                .has_current = true
                                .editing_title = "未命名草稿"
                                .editing_body = ""
                                .editing_summary = ""
                                .editing_tags = ""
                                .editing_cover = ""
                                .editing_format = "markdown"
                                .body_was_empty = true
                                .dirty = false
                                .save_state = "saved"
                                .error = ""
                                .edit_seq = .edit_seq + 1
                                .drafts = list_drafts()
                            }
                        }
                    } catch {
                        .save_in_flight = false
                        .save_state = "error"
                        .error = "create_failed"
                    }
                }
            }
        }
        .OpenDraft(id str) -> {
            if .save_in_flight {
                .save_state = "error"
                .error = "busy"
            } else {
                var can_open bool = true
                if .dirty && .has_current && .current.work_id != "" {
                    .save_in_flight = true
                    .save_state = "saving"
                    let snap_seq int = .edit_seq
                    let snap_id str = .current.work_id
                    let snap_rev int = .current.revision
                    let snap_title str = .editing_title
                    let snap_body str = .editing_body
                    let snap_summary str = .editing_summary
                    let snap_tags str = .editing_tags
                    let snap_cover str = .editing_cover
                    let snap_format str = .editing_format
                    try {
                        let r0 = save_draft(snap_id, snap_title, snap_summary, snap_body, snap_tags, snap_cover, snap_format, snap_rev)
                        if r0.ok {
                            let back = open_draft(snap_id)
                            if back.work_id != snap_id || back.revision != r0.revision || back.body != snap_body || back.title != snap_title || back.summary != snap_summary || back.tags != snap_tags || back.cover_asset != snap_cover || back.body_format != snap_format {
                                can_open = false
                                .save_state = "error"
                                .error = "readback_invalid"
                            } else {
                                .current = back
                                if .edit_seq == snap_seq {
                                    .dirty = false
                                } else {
                                    can_open = false
                                    .dirty = true
                                    .save_state = "dirty"
                                    .error = ""
                                }
                            }
                        } else {
                            can_open = false
                            if r0.conflict {
                                .save_state = "conflict"
                                .error = "conflict rev " + r0.revision.to_string()
                            } else {
                                .save_state = "error"
                                .error = "save_before_switch_failed"
                            }
                        }
                        .save_in_flight = false
                    } catch {
                        .save_in_flight = false
                        can_open = false
                        .save_state = "error"
                        .error = "save_before_switch_failed"
                    }
                }
                if can_open {
                    .save_in_flight = true
                    let pre_seq int = .edit_seq
                    try {
                        let w = open_draft(id)
                        .save_in_flight = false
                        // R-18：回执 ID 必须等于请求
                        if w.work_id == "" || w.work_id != id {
                            .save_state = "error"
                            .error = "open_failed"
                        } else {
                            if .edit_seq != pre_seq {
                                // 打开等待期发生编辑：中止切换，保留本机缓冲（R-23）
                                .dirty = true
                                .save_state = "dirty"
                            } else {
                                .current = w
                                .has_current = true
                                .editing_title = w.title
                                .editing_body = w.body
                                .editing_summary = w.summary
                                .editing_tags = w.tags
                                .editing_cover = w.cover_asset
                                .editing_format = w.body_format
                                .body_was_empty = w.body == ""
                                .dirty = false
                                .save_state = "saved"
                                .error = ""
                                .edit_seq = .edit_seq + 1
                            }
                        }
                    } catch {
                        .save_in_flight = false
                        .save_state = "error"
                        .error = "open_failed"
                    }
                }
            }
        }
        .TitleEdit(t str) -> {
            .editing_title = t
            .dirty = true
            .save_state = "dirty"
            .edit_seq = .edit_seq + 1
        }
        .BodyEdit(b str) -> {
            .editing_body = b
            .dirty = true
            .save_state = "dirty"
            .edit_seq = .edit_seq + 1
        }
        .SummaryEdit(s str) -> {
            .editing_summary = s
            .dirty = true
            .save_state = "dirty"
            .edit_seq = .edit_seq + 1
        }
        .TagsEdit(t str) -> {
            .editing_tags = t
            .dirty = true
            .save_state = "dirty"
            .edit_seq = .edit_seq + 1
        }
        .CoverEdit(c str) -> {
            .editing_cover = c
            .dirty = true
            .save_state = "dirty"
            .edit_seq = .edit_seq + 1
        }
        .FormatEdit(f str) -> {
            // 格式切换即编辑（markdown↔text 不改正文；落盘走保存；非法值忽略）
            if f == "text" || f == "markdown" {
                .editing_format = f
                .dirty = true
                .save_state = "dirty"
                .edit_seq = .edit_seq + 1
            }
        }
        .AddAssetRef(ref str, caption str) -> {
            // 资产追加=修订写：与保存同一互斥与读回确认（T-02）
            if .save_in_flight {
                .save_state = "error"
                .error = "busy"
            } else {
                if .has_current == false || .current.work_id == "" {
                    .save_state = "error"
                    .error = "no_work"
                } else {
                    .save_in_flight = true
                    .save_state = "saving"
                    let snap_id str = .current.work_id
                    let snap_rev int = .current.revision
                    try {
                        let r = add_asset_ref(snap_id, ref, caption, "copy", snap_rev)
                        if r.ok {
                            let back = open_draft(snap_id)
                            if back.work_id == "" || back.work_id != snap_id || back.revision != r.revision {
                                .save_state = "error"
                                .error = "readback_invalid"
                            } else {
                                .current = back
                                .editing_title = back.title
                                .editing_body = back.body
                                .editing_summary = back.summary
                                .editing_tags = back.tags
                                .editing_cover = back.cover_asset
                                .editing_format = back.body_format
                                .body_was_empty = back.body == ""
                                .dirty = false
                                .save_state = "saved"
                                .error = ""
                                .drafts = list_drafts()
                            }
                        } else {
                            if r.conflict {
                                .save_state = "conflict"
                                .error = "conflict rev " + r.revision.to_string()
                            } else {
                                .save_state = "error"
                                .error = r.error
                            }
                        }
                        .save_in_flight = false
                    } catch {
                        .save_in_flight = false
                        .save_state = "error"
                        .error = "network_error"
                    }
                }
            }
        }
        .ComposeImport(items str) -> {
            // 有未存编辑时先显式保存（导入创建新稿，不覆盖当前缓冲）
            if .dirty && .has_current {
                .save_state = "error"
                .error = "save_before_import"
            } else {
                if .save_in_flight {
                    .save_state = "error"
                    .error = "busy"
                } else {
                    .save_in_flight = true
                    try {
                        let w = import_compose(items)
                        .save_in_flight = false
                        if w.work_id == "" {
                            .save_state = "error"
                            .error = "compose_failed"
                        } else {
                            .current = w
                            .has_current = true
                            .editing_title = w.title
                            .editing_body = w.body
                            .editing_summary = w.summary
                            .editing_tags = w.tags
                            .editing_cover = w.cover_asset
                            .editing_format = w.body_format
                            .body_was_empty = w.body == ""
                            .dirty = false
                            .save_state = "saved"
                            .error = ""
                            .edit_seq = .edit_seq + 1
                            .drafts = list_drafts()
                        }
                    } catch {
                        .save_in_flight = false
                        .save_state = "error"
                        .error = "compose_failed"
                    }
                }
            }
        }
        .SaveCurrent -> {
            // has_current 守卫 + 统一互斥；锁覆盖保存+读回（R-23）
            if .save_in_flight {
                .save_state = "error"
                .error = "busy"
            } else {
                if .has_current == false || .current.work_id == "" {
                    .save_state = "error"
                    .error = "no_work"
                } else {
                    .save_in_flight = true
                    .save_state = "saving"
                    let snap_seq int = .edit_seq
                    let snap_title str = .editing_title
                    let snap_body str = .editing_body
                    let snap_summary str = .editing_summary
                    let snap_tags str = .editing_tags
                    let snap_cover str = .editing_cover
                    let snap_format str = .editing_format
                    let snap_rev int = .current.revision
                    let snap_id str = .current.work_id
                    try {
                        let r = save_draft(snap_id, snap_title, snap_summary, snap_body, snap_tags, snap_cover, snap_format, snap_rev)
                        if r.ok {
                            if .has_current && snap_id == .current.work_id {
                                let back = open_draft(snap_id)
                                // 全字段读回确认（R-20/24：ID/rev/正文/标题/摘要/标签/封面/格式）
                                if back.work_id == "" || back.work_id != snap_id || back.revision != r.revision || back.body != snap_body || back.title != snap_title || back.summary != snap_summary || back.tags != snap_tags || back.cover_asset != snap_cover || back.body_format != snap_format {
                                    .save_state = "error"
                                    .error = "readback_invalid"
                                } else {
                                    .current = back
                                    if .edit_seq == snap_seq {
                                        .editing_title = back.title
                                        .editing_body = back.body
                                        .editing_summary = back.summary
                                        .editing_tags = back.tags
                                        .dirty = false
                                        .save_state = "saved"
                                        .error = ""
                                    } else {
                                        .dirty = true
                                        .save_state = "dirty"
                                        .error = ""
                                    }
                                    .drafts = list_drafts()
                                }
                            }
                        } else {
                            if r.conflict {
                                .save_state = "conflict"
                                .error = "conflict rev " + r.revision.to_string()
                            } else {
                                .save_state = "error"
                                .error = r.error
                            }
                        }
                        .save_in_flight = false
                    } catch {
                        .save_in_flight = false
                        .save_state = "error"
                        .error = "network_error"
                    }
                }
            }
        }
        .ForceSave -> {
            // 与 SaveCurrent 同一互斥与同一全字段读回确认（R-19/20/23/24）
            if .save_in_flight {
                .save_state = "error"
                .error = "busy"
            } else {
                if .has_current && .current.work_id != "" {
                    .save_in_flight = true
                    .save_state = "saving"
                    let snap_seq int = .edit_seq
                    let snap_title str = .editing_title
                    let snap_body str = .editing_body
                    let snap_summary str = .editing_summary
                    let snap_tags str = .editing_tags
                    let snap_cover str = .editing_cover
                    let snap_format str = .editing_format
                    let snap_id str = .current.work_id
                    try {
                        let r = save_draft(snap_id, snap_title, snap_summary, snap_body, snap_tags, snap_cover, snap_format, 0)
                        if r.ok {
                            if .has_current && snap_id == .current.work_id {
                                let back = open_draft(snap_id)
                                if back.work_id == "" || back.work_id != snap_id || back.revision != r.revision || back.body != snap_body || back.title != snap_title || back.summary != snap_summary || back.tags != snap_tags || back.cover_asset != snap_cover || back.body_format != snap_format {
                                    .save_state = "error"
                                    .error = "readback_invalid"
                                } else {
                                    .current = back
                                    if .edit_seq == snap_seq {
                                        .editing_title = back.title
                                        .editing_body = back.body
                                        .editing_summary = back.summary
                                        .editing_tags = back.tags
                                        .dirty = false
                                        .save_state = "saved"
                                        .error = ""
                                    } else {
                                        .dirty = true
                                        .save_state = "dirty"
                                    }
                                    .drafts = list_drafts()
                                }
                            }
                        } else {
                            .save_state = "error"
                            .error = r.error
                        }
                        .save_in_flight = false
                    } catch {
                        .save_in_flight = false
                        .save_state = "error"
                        .error = "network_error"
                    }
                }
            }
        }
        .ResolveKeepMine -> {
            .ForceSave()
        }
        .ResolveKeepTheirs -> {
            if .save_in_flight {
                .save_state = "error"
                .error = "busy"
            } else {
                if .has_current && .current.work_id != "" {
                    .save_in_flight = true
                    let pre_seq int = .edit_seq
                    try {
                        let w = open_draft(.current.work_id)
                        .save_in_flight = false
                        if w.work_id == "" {
                            .save_state = "error"
                            .error = "reload_failed"
                        } else {
                            if .edit_seq != pre_seq {
                                // 重读等待期发生编辑：中止覆盖，保留本机缓冲（R-23）
                                .dirty = true
                                .save_state = "dirty"
                            } else {
                                .current = w
                                .editing_title = w.title
                                .editing_body = w.body
                                .editing_summary = w.summary
                                .editing_tags = w.tags
                                .editing_cover = w.cover_asset
                                .editing_format = w.body_format
                                .body_was_empty = w.body == ""
                                .dirty = false
                                .save_state = "saved"
                                .error = ""
                                .edit_seq = .edit_seq + 1
                            }
                        }
                    } catch {
                        .save_in_flight = false
                        .save_state = "error"
                        .error = "reload_failed"
                    }
                }
            }
        }
        .AutosaveTick -> {
            if .dirty && .has_current && .current.work_id != "" && .save_in_flight == false {
                .SaveCurrent()
            }
        }
    }
}
