// works.at — BLOG-001 Work 元数据与 ID（纯 .at，双轨兼容）。
// 不依赖 demo 用户登录。ID 改标题/slug 不变；revision 条件写。
// 序列化用手写 JSON；json_escape 用 replace（逐字节切片会吞中文）。
// 结构体一律全量构造。Work 类型在此定义；api.at 有同形 pub type。

pub type Work = {
    work_id: str
    kind: str
    title: str
    summary: str
    body_format: str
    body: str
    tags: str
    cover_asset: str
    asset_refs: str
    source_refs: str
    revision: int
    status: str
    created_at: int
    updated_at: int
}

var next_work_seq int = 1

pub fn new_work_id() str {
    let n int = next_work_seq
    next_work_seq = next_work_seq + 1
    let ms int = time.now_ms()
    return "w-" + ms.to_string() + "-" + n.to_string()
}

pub fn make_work(work_id str, p_title str, p_summary str, p_body str, p_tags str, p_status str, p_rev int, p_created int, p_updated int) Work {
    return Work {
        work_id: work_id,
        kind: "article",
        title: p_title,
        summary: p_summary,
        body_format: "text",
        body: p_body,
        tags: p_tags,
        cover_asset: "",
        asset_refs: "[]",
        source_refs: "[]",
        revision: p_rev,
        status: p_status,
        created_at: p_created,
        updated_at: p_updated
    }
}

pub fn blank_work(work_id str) Work {
    let now int = time.now_sec()
    return make_work(work_id, "", "", "", "", "draft", 1, now, now)
}

pub fn json_escape(s str) str {
    var out str = s.replace("\\", "\\\\")
    out = out.replace("\"", "\\\"")
    out = out.replace("\n", "\\n")
    out = out.replace("\r", "\\r")
    out = out.replace("\t", "\\t")
    return out
}

pub fn hex_val(c str) int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    if c == "a" || c == "A" { return 10 }
    if c == "b" || c == "B" { return 11 }
    if c == "c" || c == "C" { return 12 }
    if c == "d" || c == "D" { return 13 }
    if c == "e" || c == "E" { return 14 }
    if c == "f" || c == "F" { return 15 }
    return -1
}

fn hex4_from_cp(cp int) str {
    var d str = ""
    var x int = cp
    var k int = 0
    while k < 4 {
        let r int = x - (x / 16) * 16
        if r < 10 {
            d = r.to_string() + d
        } else {
            if r == 10 { d = "a" + d }
            if r == 11 { d = "b" + d }
            if r == 12 { d = "c" + d }
            if r == 13 { d = "d" + d }
            if r == 14 { d = "e" + d }
            if r == 15 { d = "f" + d }
        }
        x = x / 16
        k = k + 1
    }
    return d
}

/// 解析 s[p..p+5] = uXXXX（p 指向 'u'）为码点；非法返回 -1。
fn hex4_code(s str, p int) int {
    if p + 5 > s.len() {
        return -1
    }
    let hex4 str = s.slice(p + 1, p + 5)
    let h0 int = hex_val(hex4.slice(0, 1))
    let h1 int = hex_val(hex4.slice(1, 2))
    let h2 int = hex_val(hex4.slice(2, 3))
    let h3 int = hex_val(hex4.slice(3, 4))
    if h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0 {
        return -1
    }
    return h0 * 4096 + h1 * 256 + h2 * 16 + h3
}

fn ufffd() str {
    return json.parse("\"\\ufffd\"").to_string()
}

/// JSON 字符串反转义（单遍状态机；支持 \\ \" \n \r \t \uXXXX 与代理对）。
/// 代理对（R-27）：仅当当前码点真实在 D800–DBFF 且紧随 \uXXXX 在
/// DC00–DFFF 时才配对消费 12 字符；非代理区相邻 \uXXXX 逐个解码，
/// 孤立代理以 U+FFFD 替换，不吞相邻字符。
pub fn json_unescape(s str) str {
    var out str = ""
    var i int = 0
    let n int = s.len()
    while i < n {
        let rest str = s.slice(i, n)
        let bs int = rest.find("\\")
        if bs < 0 {
            out = out + rest
            return out
        }
        out = out + rest.slice(0, bs)
        let pos int = i + bs
        if pos + 1 >= n {
            return out
        }
        let d str = s.slice(pos + 1, pos + 2)
        if d == "n" {
            out = out + "\n"
            i = pos + 2
        } else {
            if d == "r" {
                out = out + "\r"
                i = pos + 2
            } else {
                if d == "t" {
                    out = out + "\t"
                    i = pos + 2
                } else {
                    if d == "\"" {
                        out = out + "\""
                        i = pos + 2
                    } else {
                        if d == "\\" {
                            out = out + "\\"
                            i = pos + 2
                        } else {
                            if d == "u" {
                                let code int = hex4_code(s, pos + 1)
                                if code < 0 {
                                    out = out + d
                                    i = pos + 2
                                } else {
                                    if code >= 55296 && code <= 56319 {
                                        // 高代理：仅真实 DC00–DFFF 后随才配对
                                        // （pos 指向 '\'；第二段 '\' 在 pos+6、'u' 在 pos+7）
                                        var paired bool = false
                                        if pos + 12 <= n {
                                            if s.slice(pos + 6, pos + 8) == "\\u" {
                                                let lo int = hex4_code(s, pos + 7)
                                                if lo >= 56320 && lo <= 57343 {
                                                    let wrapped str = "\"\\u" + s.slice(pos + 2, pos + 6) + "\\u" + s.slice(pos + 8, pos + 12) + "\""
                                                    out = out + json.parse(wrapped).to_string()
                                                    i = pos + 12
                                                    paired = true
                                                }
                                            }
                                        }
                                        if !paired {
                                            out = out + ufffd()
                                            i = pos + 6
                                        }
                                    } else {
                                        if code >= 56320 && code <= 57343 {
                                            // 孤立低代理
                                            out = out + ufffd()
                                            i = pos + 6
                                        } else {
                                            let wrapped str = "\"\\u" + s.slice(pos + 2, pos + 6) + "\""
                                            out = out + json.parse(wrapped).to_string()
                                            i = pos + 6
                                        }
                                    }
                                }
                            } else {
                                out = out + d
                                i = pos + 2
                            }
                        }
                    }
                }
            }
        }
    }
    return out
}

/// 从 JSON 对象串提取字符串字段（允许冒号前后空白；兼容 pretty）。
pub fn json_field_str(src str, key str) str {
    // 支持 "key" : "value"（冒号前后空白）
    let key_tok str = "\"" + key + "\""
    var i int = src.find(key_tok)
    if i < 0 {
        return ""
    }
    var j int = i + key_tok.len()
    let n int = src.len()
    while j < n {
        let c str = src.slice(j, j + 1)
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            j = j + 1
        } else {
            break
        }
    }
    if j >= n || src.slice(j, j + 1) != ":" {
        return ""
    }
    j = j + 1
    while j < n {
        let c str = src.slice(j, j + 1)
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            j = j + 1
        } else {
            break
        }
    }
    if j >= n || src.slice(j, j + 1) != "\"" {
        return ""
    }
    j = j + 1
    let start int = j
    while j < n {
        let c str = src.slice(j, j + 1)
        if c == "\\" {
            j = j + 2
        } else {
            if c == "\"" {
                return json_unescape(src.slice(start, j))
            } else {
                j = j + 1
            }
        }
    }
    return ""
}

pub fn json_field_int(src str, key str) int {
    let key_tok str = "\"" + key + "\""
    var i int = src.find(key_tok)
    if i < 0 {
        return 0
    }
    var j int = i + key_tok.len()
    let n int = src.len()
    while j < n {
        let c str = src.slice(j, j + 1)
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            j = j + 1
        } else {
            break
        }
    }
    if j >= n || src.slice(j, j + 1) != ":" {
        return 0
    }
    j = j + 1
    while j < n {
        let c str = src.slice(j, j + 1)
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            j = j + 1
        } else {
            break
        }
    }
    let start int = j
    if j < n && src.slice(j, j + 1) == "-" {
        j = j + 1
    }
    while j < n {
        let c str = src.slice(j, j + 1)
        if c >= "0" && c <= "9" {
            j = j + 1
        } else {
            return src.slice(start, j).to_int()
        }
    }
    return src.slice(start, j).to_int()
}

pub fn work_to_meta_json(w Work) str {
    var out str = "{"
    out = out + "\"work_id\":\"" + json_escape(w.work_id) + "\","
    out = out + "\"kind\":\"" + json_escape(w.kind) + "\","
    out = out + "\"title\":\"" + json_escape(w.title) + "\","
    out = out + "\"summary\":\"" + json_escape(w.summary) + "\","
    out = out + "\"body_format\":\"" + json_escape(w.body_format) + "\","
    out = out + "\"tags\":\"" + json_escape(w.tags) + "\","
    out = out + "\"cover_asset\":\"" + json_escape(w.cover_asset) + "\","
    out = out + "\"asset_refs\":\"" + json_escape(w.asset_refs) + "\","
    out = out + "\"source_refs\":\"" + json_escape(w.source_refs) + "\","
    out = out + "\"revision\":" + w.revision.to_string() + ","
    out = out + "\"status\":\"" + json_escape(w.status) + "\","
    out = out + "\"created_at\":" + w.created_at.to_string() + ","
    out = out + "\"updated_at\":" + w.updated_at.to_string()
    out = out + "}"
    return out
}

pub fn work_from_meta_json(meta str, body str) Work {
    let wid str = json_field_str(meta, "work_id")
    let t str = json_field_str(meta, "title")
    let sm str = json_field_str(meta, "summary")
    let bf str = json_field_str(meta, "body_format")
    let tg str = json_field_str(meta, "tags")
    let ca str = json_field_str(meta, "cover_asset")
    let ar str = json_field_str(meta, "asset_refs")
    let sr str = json_field_str(meta, "source_refs")
    let rv int = json_field_int(meta, "revision")
    let st str = json_field_str(meta, "status")
    let cat int = json_field_int(meta, "created_at")
    let uat int = json_field_int(meta, "updated_at")
    let kd str = json_field_str(meta, "kind")
    return Work {
        work_id: wid,
        kind: kd,
        title: t,
        summary: sm,
        body_format: bf,
        body: body,
        tags: tg,
        cover_asset: ca,
        asset_refs: ar,
        source_refs: sr,
        revision: rv,
        status: st,
        created_at: cat,
        updated_at: uat
    }
}

pub fn join_path(a str, b str) str {
    if a == "" {
        return b
    }
    if b == "" {
        return a
    }
    let al int = a.len()
    let last str = a.slice(al - 1, al)
    if last == "/" || last == "\\" {
        return a + b
    }
    return a + "/" + b
}
