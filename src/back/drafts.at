// drafts.at — BLOG-001 草稿持久化仓储（纯 .at，双轨 fs.* 兼容面）。
// 职责：新建/列表/打开/保存（条件 revision）/冲突保留/旧 Article 迁移。
// 不依赖 demo 用户登录。数据目录独立，不接触用户真实知识库。
// 双轨 API 面（T-00）：fs.write_text / fs.read_text / fs.exists / fs.create_dir / fs.is_dir / fs.file_size。
// 写后必须 fs.exists 校验（返回码不可信）；禁用 fs.append_text；不用 fs.read_dir（a2r 不映射）。
// 结构体一律全量构造。index.json 只存 work_id 数组，meta 存 works/<id>/meta.json。
//
// Phase 5 提交协议（R-25）：
//   完整提交 = rev meta + rev body + .ok 持久清单（身份/版本/正文长度）+ current 指针。
//   current 指针是当前确认版本的权威引用：指针目标不完整/损坏 → 可见异常（blank），
//   不静默降级到旧版或便利副本；指针缺失/为空 → 扫描恢复（撕裂候选不提升）。
//   旧格式升级：Phase 1–3 的 revision 无 .ok——仅当整个 work 无任何 .ok 时按内容
//   校验取最高完整版并补写清单；混合状态（已有 .ok）下无 .ok 的 revision 是未提交候选。
//   恢复扫描用持久高水位 + 动态边界，无固定版本上限。

use works: Work, blank_work, make_work, new_work_id, work_to_meta_json, work_from_meta_json, join_path, json_escape, json_field_str, json_field_int, hex_val

/// 保存结果（与 api.SaveResult 同形；伴生模块自持类型）。
pub type SaveResult = {
    ok: bool
    work_id: str
    revision: int
    conflict: bool
    error: str
}

pub fn data_root() str {
    let ovr str = Env.get("AUTO_BLOG_DATA")
    if ovr != "" {
        return ovr
    }
    let home str = Env.get("USERPROFILE")
    if home == "" {
        return join_path(Env.get("HOME"), ".auto-blog/data")
    }
    return join_path(home, ".auto-blog/data")
}

fn works_dir(root str) str {
    return join_path(root, "works")
}

fn work_dir(root str, work_id str) str {
    return join_path(works_dir(root), work_id)
}

fn meta_path(root str, work_id str) str {
    return join_path(work_dir(root, work_id), "meta.json")
}

fn body_path(root str, work_id str) str {
    return join_path(work_dir(root, work_id), "body.txt")
}

fn rev_dir(root str, work_id str) str {
    return join_path(work_dir(root, work_id), "revisions")
}

fn rev_meta_path(root str, work_id str, rev int) str {
    return join_path(rev_dir(root, work_id), "rev-" + rev.to_string() + ".json")
}

fn rev_body_path(root str, work_id str, rev int) str {
    return join_path(rev_dir(root, work_id), "rev-" + rev.to_string() + ".body")
}

fn rev_ok_path(root str, work_id str, rev int) str {
    return join_path(rev_dir(root, work_id), "rev-" + rev.to_string() + ".ok")
}

fn hw_path(root str, work_id str) str {
    return join_path(work_dir(root, work_id), "high-water.txt")
}

fn index_path(root str) str {
    return join_path(root, "index.json")
}

fn slug_map_path(root str) str {
    return join_path(root, "slug-map.json")
}

/// 确认写：写盘后 exists + 全文回读比对（R-01：返回码/exists 不足，锁文件会假成功）。
fn write_confirmed(path str, content str) bool {
    fs.write_text(path, content)
    if !fs.exists(path) {
        return false
    }
    let back str = fs.read_text(path)
    return back == content
}

fn write_checked(path str, content str) bool {
    return write_confirmed(path, content)
}

fn current_ptr_path(root str, work_id str) str {
    return join_path(work_dir(root, work_id), "current.txt")
}

/// 持久高水位（R-25）：已观察到的最高 revision 号。恢复扫描以此为下界扩展，
/// 无固定版本上限；仅增大，不回退。
fn read_hw(root str, work_id str) int {
    let p str = hw_path(root, work_id)
    if !fs.exists(p) {
        return 0
    }
    let v int = fs.read_text(p).trim().to_int()
    if v > 0 {
        return v
    }
    return 0
}

fn bump_hw(root str, work_id str, rev int) {
    if rev > read_hw(root, work_id) {
        write_confirmed(hw_path(root, work_id), rev.to_string())
    }
}

/// .ok 提交标记校验（R-25）。新格式 = 持久清单 JSON：
/// {"work_id":..,"revision":N,"body_len":字节数}，逐项与磁盘核对；
/// 旧格式（Phase 4）= 纯版本号文本，仅要求与 revision 一致。
fn ok_marker_valid(root str, work_id str, rev int) bool {
    let p str = rev_ok_path(root, work_id, rev)
    if !fs.exists(p) {
        return false
    }
    let t str = fs.read_text(p).trim()
    if t == "" {
        return false
    }
    if t.slice(0, 1) == "{" {
        let mid str = json_field_str(t, "work_id")
        let mrev int = json_field_int(t, "revision")
        let mlen int = json_field_int(t, "body_len")
        if mid != work_id || mrev != rev || mlen < 0 {
            return false
        }
        let rb str = rev_body_path(root, work_id, rev)
        if !fs.exists(rb) {
            return false
        }
        return fs.file_size(rb) == mlen
    }
    return t == rev.to_string()
}

/// revision 内容校验：meta+body 存在、可解析、work_id/revision 与请求一致
/// （不含 .ok 检查；R-25：错身份/缺 body 不当有效稿）。
fn revision_content_valid(root str, work_id str, rev int) bool {
    return load_revision(root, work_id, rev).work_id != ""
}

/// 读 current 指针原文（仅指针；缺失/空/非法返回 0）。
fn read_pointer(root str, work_id str) int {
    let p str = current_ptr_path(root, work_id)
    if !fs.exists(p) {
        return 0
    }
    let t str = fs.read_text(p).trim()
    if t == "" {
        return 0
    }
    let v int = t.to_int()
    if v > 0 {
        return v
    }
    return 0
}

/// 扫描恢复最高已确认 revision（R-25）。边界 = max(高水位, 最近见档 + 64)
/// 动态扩展，无固定上限；有 .ok 的最高完整版优先；整个 work 无任何 .ok 时
/// 视为 Phase 1–3 旧格式，按内容校验取最高完整版（由调用方补写清单升级）；
/// 混合状态下无 .ok 的 revision 是未提交候选，不提升、不阻断更高确认版。
fn scan_recover_rev(root str, work_id str) int {
    let hw int = read_hw(root, work_id)
    var bound int = hw + 64
    if bound < 64 {
        bound = 64
    }
    var any_ok bool = false
    var best_committed int = 0
    var best_legacy int = 0
    var k int = 1
    while k <= bound {
        let has_ok bool = fs.exists(rev_ok_path(root, work_id, k))
        let has_meta bool = fs.exists(rev_meta_path(root, work_id, k))
        let has_body bool = fs.exists(rev_body_path(root, work_id, k))
        if has_ok || has_meta || has_body {
            if k + 64 > bound {
                bound = k + 64
            }
        }
        if has_ok {
            any_ok = true
            if ok_marker_valid(root, work_id, k) && revision_content_valid(root, work_id, k) {
                best_committed = k
            }
        } else {
            if has_meta && has_body && revision_content_valid(root, work_id, k) {
                best_legacy = k
            }
        }
        k = k + 1
    }
    if any_ok {
        return best_committed
    }
    return best_legacy
}

/// 读当前已确认 revision 号（迁移等存在性检查用）：指针优先，缺失时扫描。
fn read_current_rev(root str, work_id str) int {
    let ptr int = read_pointer(root, work_id)
    if ptr > 0 {
        return ptr
    }
    return scan_recover_rev(root, work_id)
}

/// .ok 升级为持久清单 + 推进高水位（旧格式/旧标记升级，best-effort）。
fn self_heal_commit(root str, work_id str, rev int) {
    bump_hw(root, work_id, rev)
    let p str = rev_ok_path(root, work_id, rev)
    var need bool = true
    if fs.exists(p) {
        let t str = fs.read_text(p).trim()
        if t != "" && t.slice(0, 1) == "{" {
            need = false
        }
    }
    if need {
        let rb str = rev_body_path(root, work_id, rev)
        if fs.exists(rb) {
            let manifest str = "{\"work_id\":\"" + json_escape(work_id) + "\",\"revision\":" + rev.to_string() + ",\"body_len\":" + fs.file_size(rb).to_string() + "}"
            write_confirmed(p, manifest)
        }
    }
}

/// 提交新 revision：meta+body → .ok 清单 → current 指针 → 便利副本 → 高水位。
/// 指针仅在完整确认后写入（指针=权威引用，R-25）。
fn commit_revision(root str, w Work) bool {
    let wd str = work_dir(root, w.work_id)
    fs.create_dir(wd)
    fs.create_dir(rev_dir(root, w.work_id))
    let meta str = work_to_meta_json(w)
    let rm str = rev_meta_path(root, w.work_id, w.revision)
    let rb str = rev_body_path(root, w.work_id, w.revision)
    let rk str = rev_ok_path(root, w.work_id, w.revision)
    if !write_confirmed(rm, meta) {
        return false
    }
    if !write_confirmed(rb, w.body) {
        return false
    }
    let blen int = fs.file_size(rb)
    let manifest str = "{\"work_id\":\"" + json_escape(w.work_id) + "\",\"revision\":" + w.revision.to_string() + ",\"body_len\":" + blen.to_string() + "}"
    if !write_confirmed(rk, manifest) {
        return false
    }
    if !write_confirmed(current_ptr_path(root, w.work_id), w.revision.to_string()) {
        return false
    }
    write_confirmed(meta_path(root, w.work_id), meta)
    write_confirmed(body_path(root, w.work_id), w.body)
    bump_hw(root, w.work_id, w.revision)
    return true
}

/// 按 revision 号装载完整 Work；缺 body 不当空正文，身份/版本必须一致
/// （R-13/25），不完整返回 blank。
fn load_revision(root str, work_id str, rev int) Work {
    if rev <= 0 {
        return blank_work("")
    }
    let rm str = rev_meta_path(root, work_id, rev)
    let rb str = rev_body_path(root, work_id, rev)
    if !fs.exists(rm) {
        return blank_work("")
    }
    // 缺 body → 不完整，拒绝
    if !fs.exists(rb) {
        return blank_work("")
    }
    let meta str = fs.read_text(rm)
    if meta == "" {
        return blank_work("")
    }
    let body str = fs.read_text(rb)
    let w Work = work_from_meta_json(meta, body)
    if w.work_id == "" || w.work_id != work_id || w.revision != rev {
        return blank_work("")
    }
    return w
}

/// 装载当前确认版本（R-25）。指针存在时指针即权威：目标内容不完整/
/// 身份不符，或 .ok 清单存在且与磁盘矛盾 → 返回 blank（可见恢复异常），
/// 不静默降级；指针缺失/为空 → 扫描最高确认版（撕裂候选不提升，全旧
/// 格式按内容升级）；最后兼容 Phase 1 纯便利副本。
fn load_work(root str, work_id str) Work {
    let ptr int = read_pointer(root, work_id)
    if ptr > 0 {
        var marker_ok bool = true
        if fs.exists(rev_ok_path(root, work_id, ptr)) {
            marker_ok = ok_marker_valid(root, work_id, ptr)
        }
        if revision_content_valid(root, work_id, ptr) && marker_ok {
            let w Work = load_revision(root, work_id, ptr)
            if w.work_id != "" {
                self_heal_commit(root, work_id, ptr)
                return w
            }
        }
        return blank_work("")
    }
    let best int = scan_recover_rev(root, work_id)
    if best > 0 {
        let w Work = load_revision(root, work_id, best)
        if w.work_id != "" {
            self_heal_commit(root, work_id, best)
            return w
        }
    }
    let mp str = meta_path(root, work_id)
    if !fs.exists(mp) {
        return blank_work("")
    }
    let meta str = fs.read_text(mp)
    if meta == "" {
        return blank_work("")
    }
    var body str = ""
    let bp str = body_path(root, work_id)
    if fs.exists(bp) {
        body = fs.read_text(bp)
    }
    let w Work = work_from_meta_json(meta, body)
    if w.work_id != work_id {
        return blank_work("")
    }
    return w
}

fn write_work_files(root str, w Work) bool {
    let ok bool = commit_revision(root, w)
    if ok {
        return index_add(root, w.work_id)
    }
    return false
}

fn read_index(root str) str {
    let p str = index_path(root)
    if !fs.exists(p) {
        return "[]"
    }
    let s str = fs.read_text(p)
    if s == "" {
        return "[]"
    }
    return s
}

fn write_index(root str, arr str) bool {
    fs.create_dir(root)
    return write_checked(index_path(root), arr)
}

/// 简易 JSON 字符串数组解析：返回拼接串，元素用 \n 分隔。
fn parse_id_array(arr str) str {
    var s str = arr
    if s.len() >= 2 && s.slice(0, 1) == "[" {
        s = s.slice(1, s.len() - 1)
    }
    var out str = ""
    var i int = 0
    let n int = s.len()
    while i < n {
        let c str = s.slice(i, i + 1)
        if c == "\"" {
            var j int = i + 1
            while j < n && s.slice(j, j + 1) != "\"" {
                j = j + 1
            }
            let id str = s.slice(i + 1, j)
            if id != "" {
                out = out + id + "\n"
            }
            i = j + 1
        } else {
            i = i + 1
        }
    }
    return out
}

/// 将 \n 分隔的 id 列表序列化回 JSON 数组。
fn ids_to_json(ids str) str {
    var out str = "["
    var first bool = true
    var i int = 0
    let n int = ids.len()
    while i < n {
        var j int = i
        while j < n && ids.slice(j, j + 1) != "\n" {
            j = j + 1
        }
        let id str = ids.slice(i, j)
        if id != "" {
            if !first {
                out = out + ","
            }
            first = false
            out = out + "\"" + json_escape(id) + "\""
        }
        i = j + 1
    }
    out = out + "]"
    return out
}

fn index_has(ids str, work_id str) bool {
    return ids.find(work_id + "\n") >= 0
}

fn index_add(root str, work_id str) bool {
    let ids str = parse_id_array(read_index(root))
    if index_has(ids, work_id) {
        return true
    }
    return write_index(root, ids_to_json(ids + work_id + "\n"))
}

// --- 对外 API ---

/// 新建草稿。p_format 仅接受 text/markdown（其余归一为 text，BLOG-002 T-01）。
/// 失败返回 blank_work("")。
pub fn create_draft(p_title str, p_body str, p_format str) Work {
    let root str = data_root()
    fs.create_dir(works_dir(root))
    let work_id str = new_work_id()
    let now int = time.now_sec()
    let w Work = make_work(work_id, p_title, "", p_body, "", "draft", 1, now, now, p_format, "")
    let ok bool = write_work_files(root, w)
    if !ok {
        return blank_work("")
    }
    // 直接返回 Work（勿嵌套——长串会被截断）
    return make_work(work_id, p_title, "", p_body, "", "draft", 1, now, now, p_format, "")
}

/// 打开草稿。失败返回 blank_work("")。
pub fn open_draft(work_id str) Work {
    let root str = data_root()
    return load_work(root, work_id)
}

/// 保存（条件 revision）。expected_rev=0 强制；>0 条件写。
/// p_cover/p_format：格式仅接受 text/markdown，空或非法值保留当前值（不静默改格式）。
pub fn save_draft(work_id str, p_title str, p_summary str, p_body str, p_tags str, p_cover str, p_format str, expected_rev int) SaveResult {
    let root str = data_root()
    let cur Work = load_work(root, work_id)
    if cur.work_id == "" {
        return SaveResult { ok: false, work_id: work_id, revision: 0, conflict: false, error: "not_found" }
    }
    if expected_rev > 0 && cur.revision != expected_rev {
        return SaveResult { ok: false, work_id: work_id, revision: cur.revision, conflict: true, error: "conflict" }
    }
    var fmt str = p_format
    if fmt != "text" && fmt != "markdown" {
        fmt = cur.body_format
    }
    let next_rev int = cur.revision + 1
    let now int = time.now_sec()
    let next Work = make_work(work_id, p_title, p_summary, p_body, p_tags, cur.status, next_rev, cur.created_at, now, fmt, p_cover)
    let ok bool = write_work_files(root, next)
    if !ok {
        return SaveResult { ok: false, work_id: work_id, revision: cur.revision, conflict: false, error: "save_failed" }
    }
    return SaveResult { ok: true, work_id: work_id, revision: next_rev, conflict: false, error: "" }
}

/// 列表：返回 []Work（body 为空，不含正文）。
pub fn list_drafts() []Work {
    let root str = data_root()
    let ids str = parse_id_array(read_index(root))
    var out []Work = []
    var i int = 0
    let n int = ids.len()
    while i < n {
        var j int = i
        while j < n && ids.slice(j, j + 1) != "\n" {
            j = j + 1
        }
        let id str = ids.slice(i, j)
        i = j + 1
        if id != "" {
            let mp str = meta_path(root, id)
            if fs.exists(mp) {
                let meta str = fs.read_text(mp)
                if meta != "" {
                    let w Work = work_from_meta_json(meta, "")
                    out.push(w)
                }
            }
        }
    }
    return out
}

// --- 迁移 ---

fn read_slug_map(root str) str {
    let p str = slug_map_path(root)
    if !fs.exists(p) {
        return "{}"
    }
    let s str = fs.read_text(p)
    if s == "" {
        return "{}"
    }
    return s
}

fn write_slug_map(root str, map_json str) bool {
    fs.create_dir(root)
    return write_confirmed(slug_map_path(root), map_json)
}

/// 备份现有文件到 <path>.bak-<ms>；成功返回备份路径，无原文件返回空串。
fn backup_file(path str) str {
    if !fs.exists(path) {
        return ""
    }
    let old str = fs.read_text(path)
    let bak str = path + ".bak-" + time.now_ms().to_string()
    if write_confirmed(bak, old) {
        return bak
    }
    return ""
}

pub fn slug_to_work_id(slug str) str {
    let root str = data_root()
    let map str = read_slug_map(root)
    return json_field_str(map, json_escape(slug))
}

fn pending_map_path(root str) str {
    return join_path(root, "pending-migrate.json")
}

fn read_pending_map(root str) str {
    let p str = pending_map_path(root)
    if !fs.exists(p) {
        return "{}"
    }
    let s str = fs.read_text(p)
    if s == "" {
        return "{}"
    }
    return s
}

fn write_pending_map(root str, map_json str) bool {
    return write_confirmed(pending_map_path(root), map_json)
}

/// 向 JSON 对象串插入/替换 key→str 值（R-29）。
/// 键以转义形态查找/写入：已存在则原位替换 value（消除重复键），
/// 不存在才追加。
fn map_put(obj str, key str, val str) str {
    let ek str = json_escape(key)
    let marker str = "\"" + ek + "\":\""
    let hit int = obj.find(marker)
    if hit >= 0 {
        let vstart int = hit + marker.len()
        let n int = obj.len()
        var j int = vstart
        while j < n {
            let c str = obj.slice(j, j + 1)
            if c == "\\" {
                j = j + 2
            } else {
                if c == "\"" {
                    break
                } else {
                    j = j + 1
                }
            }
        }
        return obj.slice(0, vstart) + json_escape(val) + obj.slice(j, n)
    }
    let stripped str = map_str_strip_close(obj)
    let entry str = "\"" + ek + "\":\"" + json_escape(val) + "\""
    if stripped == "{" {
        return "{" + entry + "}"
    }
    return stripped + "," + entry + "}"
}

fn source_map_path(root str) str {
    return join_path(root, "source-map.json")
}

fn read_source_map(root str) str {
    let p str = source_map_path(root)
    if !fs.exists(p) {
        return "{}"
    }
    let s str = fs.read_text(p)
    if s == "" {
        return "{}"
    }
    return s
}

fn write_source_map(root str, map_json str) bool {
    fs.create_dir(root)
    return write_confirmed(source_map_path(root), map_json)
}

/// 组合迁移键（R-26）。默认保持旧格式字面量 "author::slug"；
/// 仅当任一组件自身含 "::" 时切换为长度编码 "<len>::<author>::<slug>"，
/// 使 (author="A::B", slug="C") 与 (author="A", slug="B::C") 不再共享键。
/// 编码态文本（首段为长度、其后组件必含 "::"）与字面量态文本（两组件
/// 均不含 "::"）不相交，整键映射单射。
fn migrate_key(p_author str, slug str) str {
    var src str = p_author
    if src == "" {
        src = "_"
    }
    if src.find("::") >= 0 || slug.find("::") >= 0 {
        return src.len().to_string() + "::" + src + "::" + slug
    }
    return src + "::" + slug
}

/// 旧格式键（revision 4/5 的 author::slug），升级期兼容查找用。
fn legacy_migrate_key(p_author str, slug str) str {
    var src str = p_author
    if src == "" {
        src = "_"
    }
    return src + "::" + slug
}

/// source-map 是否已有任一来源认领该作品 ID（R-26）。source-map 的
/// 值均为 work_id（形如 "w-..."，键内引号必被转义），因此值起始的
/// '"w-' 序列只会出现在值首。用于旧 slug-map 沿用前的归属检查：
/// 已被其他来源认领的 ID 不得再次沿用。
fn source_map_claims(root str, work_id str) bool {
    var rest str = read_source_map(root)
    let needle str = "\"w-"
    var found bool = false
    var scanning bool = true
    while scanning {
        let hit int = rest.find(needle)
        if hit < 0 {
            scanning = false
        } else {
            rest = rest.slice(hit + 1, rest.len())
            let m int = rest.len()
            var j int = 0
            while j < m && rest.slice(j, j + 1) != "\"" {
                j = j + 1
            }
            let val str = rest.slice(0, j)
            if val == work_id {
                found = true
                scanning = false
            } else {
                if j + 1 >= m {
                    scanning = false
                } else {
                    rest = rest.slice(j + 1, m)
                }
            }
        }
    }
    return found
}

pub fn migrate_article(slug str, p_title str, p_description str, p_body str, p_tagList str, p_author str) str {
    let root str = data_root()
    let mkey str = migrate_key(p_author, slug)
    let oldkey str = legacy_migrate_key(p_author, slug)
    fs.create_dir(root)
    fs.create_dir(works_dir(root))
    let smap str = read_source_map(root)
    // R-29：查找统一使用转义后键（与 map_put 写入形态一致；无引号键为恒等）
    var existing str = json_field_str(smap, json_escape(mkey))
    if existing == "" {
        // 旧格式 source-map 键的升级期兼容查找（R-26）
        existing = json_field_str(smap, json_escape(oldkey))
    }
    if existing != "" {
        // 幂等早返回同样核对/修复 index、legacy-map 与作品文件（R-26）
        if !index_add(root, existing) {
            return ""
        }
        let lmap str = read_slug_map(root)
        if json_field_str(lmap, json_escape(slug)) != existing {
            if !write_slug_map(root, map_put(lmap, slug, existing)) {
                backup_file(slug_map_path(root))
                return ""
            }
        }
        if read_current_rev(root, existing) <= 0 && !fs.exists(meta_path(root, existing)) {
            let now int = time.now_sec()
            let w Work = make_work(existing, p_title, p_description, p_body, p_tagList, "draft", 1, now, now, "text", "")
            if !write_work_files(root, w) {
                return ""
            }
        }
        return existing
    }
    let pending str = read_pending_map(root)
    var work_id str = json_field_str(pending, json_escape(mkey))
    if work_id == "" {
        // 旧 slug-map（Phase 1–3）身份升级：沿用已迁移作品 ID，不重复建稿；
        // 但该 ID 已被 source-map 中其他来源认领时不得沿用（R-26）
        let lmap0 str = read_slug_map(root)
        let legacy_id str = json_field_str(lmap0, json_escape(slug))
        if legacy_id != "" && !source_map_claims(root, legacy_id) {
            work_id = legacy_id
        }
    }
    if work_id == "" {
        work_id = new_work_id()
        if !write_pending_map(root, map_put(pending, mkey, work_id)) {
            return ""
        }
    }
    fs.create_dir(works_dir(root))
    let now int = time.now_sec()
    let cur_rev int = read_current_rev(root, work_id)
    if cur_rev <= 0 {
        let w Work = make_work(work_id, p_title, p_description, p_body, p_tagList, "draft", 1, now, now, "text", "")
        if !write_work_files(root, w) {
            return ""
        }
    } else {
        if !index_add(root, work_id) {
            return ""
        }
    }
    if !write_source_map(root, map_put(read_source_map(root), mkey, work_id)) {
        backup_file(source_map_path(root))
        return ""
    }
    let lmap str = read_slug_map(root)
    if json_field_str(lmap, json_escape(slug)) != work_id {
        if !write_slug_map(root, map_put(lmap, slug, work_id)) {
            backup_file(slug_map_path(root))
            return ""
        }
    }
    return work_id
}
fn map_str_strip_close(s str) str {
    let n int = s.len()
    if n >= 1 && s.slice(n - 1, n) == "}" {
        return s.slice(0, n - 1)
    }
    return s
}

/// 跳过 JSON 字符串（含转义）；返回字符串结束后的下标。
fn skip_json_string(s str, start int) int {
    // start 指向开引号之后
    var j int = start
    let n int = s.len()
    while j < n {
        let c str = s.slice(j, j + 1)
        if c == "\\" {
            j = j + 2
        } else {
            if c == "\"" {
                return j + 1
            } else {
                j = j + 1
            }
        }
    }
    return n
}

/// 跳过空白；返回下一个非空白下标。
fn skip_ws(s str, i int) int {
    var j int = i
    let n int = s.len()
    while j < n {
        let c str = s.slice(j, j + 1)
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            j = j + 1
        } else {
            break
        }
    }
    return j
}

/// 校验 JSON 字符串与转义（R-27）；start 指向开引号，返回闭引号后下标，非法 -1。
fn scan_json_string(s str, start int) int {
    let n int = s.len()
    var j int = start + 1
    while j < n {
        let c str = s.slice(j, j + 1)
        if c == "\"" {
            return j + 1
        }
        if c == "\\" {
            if j + 1 >= n {
                return -1
            }
            let e str = s.slice(j + 1, j + 2)
            if e == "\"" || e == "\\" || e == "/" || e == "b" || e == "f" || e == "n" || e == "r" || e == "t" {
                j = j + 2
            } else {
                if e == "u" {
                    if j + 6 > n {
                        return -1
                    }
                    if hex_val(s.slice(j + 2, j + 3)) < 0 || hex_val(s.slice(j + 3, j + 4)) < 0 || hex_val(s.slice(j + 4, j + 5)) < 0 || hex_val(s.slice(j + 5, j + 6)) < 0 {
                        return -1
                    }
                    j = j + 6
                } else {
                    return -1
                }
            }
        } else {
            j = j + 1
        }
    }
    return -1
}

/// 校验 JSON 数字（-? 整数 [. 分数] [eE 指数]）；返回结束下标，非法 -1。
fn scan_json_number(s str, start int) int {
    let n int = s.len()
    var j int = start
    if j < n && s.slice(j, j + 1) == "-" {
        j = j + 1
    }
    var digits int = 0
    while j < n {
        let c str = s.slice(j, j + 1)
        if c >= "0" && c <= "9" {
            digits = digits + 1
            j = j + 1
        } else {
            break
        }
    }
    if digits == 0 {
        return -1
    }
    if j < n && s.slice(j, j + 1) == "." {
        j = j + 1
        var fd int = 0
        while j < n {
            let c str = s.slice(j, j + 1)
            if c >= "0" && c <= "9" {
                fd = fd + 1
                j = j + 1
            } else {
                break
            }
        }
        if fd == 0 {
            return -1
        }
    }
    if j < n {
        let c str = s.slice(j, j + 1)
        if c == "e" || c == "E" {
            j = j + 1
            if j < n {
                let sc str = s.slice(j, j + 1)
                if sc == "+" || sc == "-" {
                    j = j + 1
                }
            }
            var ed int = 0
            while j < n {
                let c str = s.slice(j, j + 1)
                if c >= "0" && c <= "9" {
                    ed = ed + 1
                    j = j + 1
                } else {
                    break
                }
            }
            if ed == 0 {
                return -1
            }
        }
    }
    return j
}

/// 完整 JSON 校验（R-27）：结构/逗号/冒号/转义/字面量/数字/嵌套全检，
/// 且根数组每个元素必须是对象。校验在任何迁移副作用之前完成，
/// 失败即整体拒绝（零副作用）。
fn json_array_valid(items str) bool {
    var s str = items.trim()
    let n int = s.len()
    if n < 2 {
        return false
    }
    if s.slice(0, 1) != "[" || s.slice(n - 1, n) != "]" {
        return false
    }
    // 栈：A=数组待值(可闭) a=数组已有元素 K=对象待键(可闭) o=对象已有键值对
    var stack str = "A"
    var i int = 1
    var expect str = "value"
    while i < n {
        if expect == "value" {
            i = skip_ws(s, i)
            if i >= n {
                return false
            }
            let c str = s.slice(i, i + 1)
            let top str = stack.slice(stack.len() - 1, stack.len())
            // 根数组元素必须是对象（迁移合同类型检查）
            if stack.len() == 1 && c != "{" {
                return false
            }
            if c == "[" {
                stack = stack + "A"
                i = i + 1
            } else {
                if c == "{" {
                    stack = stack + "K"
                    i = i + 1
                    expect = "key"
                } else {
                    if c == "]" && top == "A" {
                        stack = stack.slice(0, stack.len() - 1)
                        i = i + 1
                        expect = "after"
                    } else {
                        if c == "\"" {
                            let e int = scan_json_string(s, i)
                            if e < 0 {
                                return false
                            }
                            i = e
                            if top == "A" {
                                stack = stack.slice(0, stack.len() - 1) + "a"
                            } else {
                                if top == "K" {
                                    stack = stack.slice(0, stack.len() - 1) + "o"
                                }
                            }
                            expect = "after"
                        } else {
                            if (c >= "0" && c <= "9") || c == "-" {
                                let e int = scan_json_number(s, i)
                                if e < 0 {
                                    return false
                                }
                                i = e
                                if top == "A" {
                                    stack = stack.slice(0, stack.len() - 1) + "a"
                                } else {
                                    if top == "K" {
                                        stack = stack.slice(0, stack.len() - 1) + "o"
                                    }
                                }
                                expect = "after"
                            } else {
                                var lit int = 0
                                if i + 4 <= n && s.slice(i, i + 4) == "true" {
                                    lit = 4
                                }
                                if lit == 0 && i + 5 <= n && s.slice(i, i + 5) == "false" {
                                    lit = 5
                                }
                                if lit == 0 && i + 4 <= n && s.slice(i, i + 4) == "null" {
                                    lit = 4
                                }
                                if lit == 0 {
                                    return false
                                }
                                i = i + lit
                                if top == "A" {
                                    stack = stack.slice(0, stack.len() - 1) + "a"
                                } else {
                                    if top == "K" {
                                        stack = stack.slice(0, stack.len() - 1) + "o"
                                    }
                                }
                                expect = "after"
                            }
                        }
                    }
                }
            }
        } else {
            if expect == "key" {
                i = skip_ws(s, i)
                if i >= n {
                    return false
                }
                let c str = s.slice(i, i + 1)
                let top str = stack.slice(stack.len() - 1, stack.len())
                if c == "}" && top == "K" {
                    stack = stack.slice(0, stack.len() - 1)
                    i = i + 1
                    expect = "after"
                } else {
                    if c == "\"" {
                        let e int = scan_json_string(s, i)
                        if e < 0 {
                            return false
                        }
                        i = e
                        expect = "colon"
                    } else {
                        return false
                    }
                }
            } else {
                if expect == "colon" {
                    i = skip_ws(s, i)
                    if i >= n {
                        return false
                    }
                    if s.slice(i, i + 1) != ":" {
                        return false
                    }
                    i = i + 1
                    expect = "value"
                } else {
                    // expect == "after"
                    i = skip_ws(s, i)
                    if i >= n {
                        return false
                    }
                    if stack == "" {
                        return false
                    }
                    let c str = s.slice(i, i + 1)
                    let top str = stack.slice(stack.len() - 1, stack.len())
                    if c == "," {
                        if top == "a" {
                            expect = "value"
                        } else {
                            if top == "o" {
                                expect = "key"
                            } else {
                                return false
                            }
                        }
                        i = i + 1
                    } else {
                        if c == "]" {
                            if top != "A" && top != "a" {
                                return false
                            }
                            stack = stack.slice(0, stack.len() - 1)
                            i = i + 1
                            expect = "after"
                            // 闭合一层后父容器记为已有元素
                            if stack != "" {
                                let pt str = stack.slice(stack.len() - 1, stack.len())
                                if pt == "A" {
                                    stack = stack.slice(0, stack.len() - 1) + "a"
                                } else {
                                    if pt == "K" {
                                        stack = stack.slice(0, stack.len() - 1) + "o"
                                    }
                                }
                            }
                        } else {
                            if c == "}" {
                                if top != "K" && top != "o" {
                                    return false
                                }
                                stack = stack.slice(0, stack.len() - 1)
                                i = i + 1
                                expect = "after"
                                if stack != "" {
                                    let pt str = stack.slice(stack.len() - 1, stack.len())
                                    if pt == "A" {
                                        stack = stack.slice(0, stack.len() - 1) + "a"
                                    } else {
                                        if pt == "K" {
                                            stack = stack.slice(0, stack.len() - 1) + "o"
                                        }
                                    }
                                }
                            } else {
                                return false
                            }
                        }
                    }
                }
            }
        }
    }
    return stack == "" && expect == "after"
}

/// 字段值类型检查（R-28）：返回 1=字符串值，0=字段不存在，-1=存在但非字符串。
/// 与 json_field_str 同样按首次出现查找（迁移合同为扁平文章对象）。
fn json_field_value_kind(obj str, key str) int {
    let key_tok str = "\"" + key + "\""
    var i int = obj.find(key_tok)
    if i < 0 {
        return 0
    }
    var j int = i + key_tok.len()
    let n int = obj.len()
    while j < n {
        let c str = obj.slice(j, j + 1)
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            j = j + 1
        } else {
            break
        }
    }
    if j >= n || obj.slice(j, j + 1) != ":" {
        return -1
    }
    j = j + 1
    while j < n {
        let c str = obj.slice(j, j + 1)
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            j = j + 1
        } else {
            break
        }
    }
    if j >= n {
        return -1
    }
    if obj.slice(j, j + 1) == "\"" {
        return 1
    }
    return -1
}

/// 批级字段类型预扫（R-28）：任何顶层对象的已知字段存在且非字符串
/// → 整批拒绝（在任何迁移副作用之前）。
fn batch_fields_valid(items str) bool {
    var s str = items.trim()
    if s.len() >= 2 && s.slice(0, 1) == "[" {
        s = s.slice(1, s.len() - 1)
    }
    var i int = 0
    let n int = s.len()
    while i < n {
        let c str = s.slice(i, i + 1)
        if c == "\"" {
            i = skip_json_string(s, i + 1)
        } else {
            if c == "{" {
                var depth int = 1
                var j int = i + 1
                while j < n && depth > 0 {
                    let d str = s.slice(j, j + 1)
                    if d == "\"" {
                        j = skip_json_string(s, j + 1)
                    } else {
                        if d == "{" {
                            depth = depth + 1
                            j = j + 1
                        } else {
                            if d == "}" {
                                depth = depth - 1
                                j = j + 1
                            } else {
                                j = j + 1
                            }
                        }
                    }
                }
                let obj str = s.slice(i, j)
                if json_field_value_kind(obj, "slug") < 0 || json_field_value_kind(obj, "title") < 0 || json_field_value_kind(obj, "description") < 0 || json_field_value_kind(obj, "body") < 0 || json_field_value_kind(obj, "tagList") < 0 || json_field_value_kind(obj, "author") < 0 {
                    return false
                }
                i = j
            } else {
                i = i + 1
            }
        }
    }
    return true
}

/// 批量迁移。items_json 为对象数组串（允许 pretty 空白）。幂等。
/// R-27：完整 JSON 校验在任何副作用之前，失败零写入。
/// R-28：已知字段存在则必须是字符串，类型不符整批拒绝。
pub fn migrate_articles_batch(items_json str) int {
    if !json_array_valid(items_json) {
        return 0
    }
    if !batch_fields_valid(items_json) {
        return 0
    }
    var count int = 0
    var s str = items_json.trim()
    if s.len() >= 2 && s.slice(0, 1) == "[" {
        s = s.slice(1, s.len() - 1)
    }
    var i int = 0
    let n int = s.len()
    while i < n {
        let c str = s.slice(i, i + 1)
        if c == "\"" {
            i = skip_json_string(s, i + 1)
        } else {
            if c == "{" {
                var depth int = 1
                var j int = i + 1
                while j < n && depth > 0 {
                    let d str = s.slice(j, j + 1)
                    if d == "\"" {
                        j = skip_json_string(s, j + 1)
                    } else {
                        if d == "{" {
                            depth = depth + 1
                            j = j + 1
                        } else {
                            if d == "}" {
                                depth = depth - 1
                                j = j + 1
                            } else {
                                j = j + 1
                            }
                        }
                    }
                }
                let obj str = s.slice(i, j)
                let slug str = json_field_str(obj, "slug")
                if slug != "" {
                    let wid str = migrate_article(
                        slug,
                        json_field_str(obj, "title"),
                        json_field_str(obj, "description"),
                        json_field_str(obj, "body"),
                        json_field_str(obj, "tagList"),
                        json_field_str(obj, "author")
                    )
                    if wid != "" {
                        count = count + 1
                    }
                }
                i = j
            } else {
                i = i + 1
            }
        }
    }
    return count
}

/// 迁移状态摘要。
pub fn migration_status() str {
    let root str = data_root()
    let map str = read_slug_map(root)
    let ids str = read_index(root)
    var out str = "{"
    out = out + "\"slug_map\":" + map + ","
    out = out + "\"data_root\":\"" + json_escape(root) + "\","
    out = out + "\"index\":" + ids
    out = out + "}"
    return out
}

// --- BLOG-002 T-02：资产引用与来源导入 ---

/// 向 asset_refs 追加一条图片资产（服务端组合 JSON，前端不拼串）。
/// 条目形态（设计跨应用契约 v1 AssetRef 的应用内落地；缺失值显式 null）：
/// {"asset_id","kind","storage_ref","caption","mime","mode"}，mode: "copy"|"reference"。
/// 条件 revision 写（expected_rev=0 强制）；成功推进 revision。
pub fn add_asset_ref(work_id str, storage_ref str, caption str, mode str, expected_rev int) SaveResult {
    let root str = data_root()
    let cur Work = load_work(root, work_id)
    if cur.work_id == "" {
        return SaveResult { ok: false, work_id: work_id, revision: 0, conflict: false, error: "not_found" }
    }
    if expected_rev > 0 && cur.revision != expected_rev {
        return SaveResult { ok: false, work_id: work_id, revision: cur.revision, conflict: true, error: "conflict" }
    }
    if storage_ref == "" {
        return SaveResult { ok: false, work_id: work_id, revision: cur.revision, conflict: false, error: "empty_ref" }
    }
    if mode != "copy" && mode != "reference" {
        return SaveResult { ok: false, work_id: work_id, revision: cur.revision, conflict: false, error: "bad_mode" }
    }
    let asset_id str = "a-" + time.now_ms().to_string() + "-" + (cur.revision + 1).to_string()
    var entry str = "{\"asset_id\":\"" + json_escape(asset_id) + "\",\"kind\":\"image\",\"storage_ref\":\"" + json_escape(storage_ref) + "\",\"caption\":\"" + json_escape(caption) + "\",\"mime\":\"\",\"sha256\":null,\"size\":null,\"mode\":\"" + mode + "\"}"
    // JSON Lines 追加（零索引；.len() 字节与 .slice() 字符单位在中文下错位=F-8，
    // 任何基于 len/slice 的尾部改写都被禁——001 规则 4 同源）
    var refs str = cur.asset_refs
    if refs == "[]" || refs == "" {
        refs = entry
    } else {
        refs = refs + "
" + entry
    }
    // 正文同步追加图片行（说明=alt 文本），资产与正文一致可见
    var body str = cur.body
    if caption != "" {
        body = body + "\n\n![" + caption + "](" + storage_ref + ")\n"
    } else {
        body = body + "\n\n![](" + storage_ref + ")\n"
    }
    let next_rev int = cur.revision + 1
    let now int = time.now_sec()
    let next Work = make_work(work_id, cur.title, cur.summary, body, cur.tags, cur.status, next_rev, cur.created_at, now, cur.body_format, cur.cover_asset)
    // asset_refs 不走 make_work 参数，直接构造后覆写
    let next2 Work = Work {
        work_id: next.work_id,
        kind: next.kind,
        title: next.title,
        summary: next.summary,
        body_format: next.body_format,
        body: next.body,
        tags: next.tags,
        cover_asset: next.cover_asset,
        asset_refs: refs,
        source_refs: cur.source_refs,
        revision: next.revision,
        status: next.status,
        created_at: next.created_at,
        updated_at: next.updated_at
    }
    if !write_work_files(root, next2) {
        return SaveResult { ok: false, work_id: work_id, revision: cur.revision, conflict: false, error: "save_failed" }
    }
    return SaveResult { ok: true, work_id: work_id, revision: next_rev, conflict: false, error: "" }
}

/// 从多个来源 envelope 组合创建新作品（显式导入副本；原 envelope/笔记零写入）。
/// items_json = JSON 数组，每项：
/// {"producer","title","body","original_uri","captured_at","locator","source_revision","mode"}
/// producer/body 必填；mode 缺省 "copy"（显式导入副本），"reference" 仅登记来源不并入正文。
/// 成功返回新 Work（source_refs 精确记录各来源）；无任何有效来源返回 blank_work("")。
pub fn compose_from_sources(items_json str) Work {
    // 结构门（compose 专用）：首尾括号 + find 基逐对象提取。不逐字节扫描
    // （001 规则 4：逐字节 slice 拼串吞中文；T-02 实证字节扫描在中文输入下
    // 错位 → count=0 空返回，登记 F-8）。对象值含 "{" 或 "}" 时该对象不
    // 可靠——envelope 契约字段为纯文本，此类输入被跳过（边界写入 spec）。
    // count==0 时在任何写副作用之前返回空（拒绝零写入）。
    let tn int = items_json.len()
    if tn < 2 {
        return blank_work("")
    }
    var rest str = items_json
    var body str = ""
    var refs str = ""
    var count int = 0
    var title str = "导入合成"
    var guard int = 0
    while guard < 64 {
        guard = guard + 1
        let lb int = rest.find("{")
        if lb < 0 {
            break
        }
        let tail str = rest.slice(lb + 1, rest.len())
        let rb int = tail.find("}")
        if rb < 0 {
            break
        }
        let obj str = tail.slice(0, rb)
        rest = tail.slice(rb + 1, tail.len())
        let producer str = json_field_str(obj, "producer")
        let sbody str = json_field_str(obj, "body")
        if producer != "" && sbody != "" {
            let stitle str = json_field_str(obj, "title")
            let uri str = json_field_str(obj, "original_uri")
            let cap int = json_field_int(obj, "captured_at")
            let loc str = json_field_str(obj, "locator")
            let srev int = json_field_int(obj, "source_revision")
            var mode str = json_field_str(obj, "mode")
            if mode != "reference" {
                mode = "copy"
            }
            count = count + 1
            if count == 1 && stitle != "" {
                title = "导入：" + stitle
            }
            if mode == "copy" {
                if body != "" {
                    body = body + "

---

"
                }
                if stitle != "" {
                    body = body + "## " + stitle + "

"
                }
                body = body + sbody
            }
            if refs != "" {
                refs = refs + "
"
            }
            var uri_j str = "null"
            if uri != "" {
                uri_j = "\"" + json_escape(uri) + "\""
            }
            var loc_j str = "null"
            if loc != "" {
                loc_j = "\"" + json_escape(loc) + "\""
            }
            var stitle_j str = "null"
            if stitle != "" {
                stitle_j = "\"" + json_escape(stitle) + "\""
            }
            var r str = "{\"producer\":\"" + json_escape(producer) + "\",\"original_uri\":" + uri_j + ",\"captured_at\":" + cap.to_string() + ",\"locator\":" + loc_j + ",\"source_revision\":" + srev.to_string() + ",\"mode\":\"" + mode + "\",\"title\":" + stitle_j + "}"
            refs = refs + r
        }
    }
    if count == 0 {
        return blank_work("")
    }
    let root str = data_root()
    fs.create_dir(works_dir(root))
    let work_id str = new_work_id()
    let now int = time.now_sec()
    let w Work = make_work(work_id, title, "", body, "imported", "draft", 1, now, now, "markdown", "")
    let w2 Work = Work {
        work_id: w.work_id,
        kind: w.kind,
        title: w.title,
        summary: w.summary,
        body_format: w.body_format,
        body: w.body,
        tags: w.tags,
        cover_asset: w.cover_asset,
        asset_refs: "[]",
        source_refs: refs,
        revision: w.revision,
        status: w.status,
        created_at: w.created_at,
        updated_at: w.updated_at
    }
    if !write_work_files(root, w2) {
        return blank_work("")
    }
    return w2
}

// --- BLOG-002 T-03：资产检查（预览缺资源可读提示）---

/// 预览资产检查报告（单行文本；find 基解析 JSON Lines，零逐字节扫描）。
/// 分类：远程（http/https，断网显示断图）/ 本地（浏览器预览不可解析，导出时打包）/ 缺失（空引用）。
pub fn asset_check_report(work_id str) str {
    let cur Work = load_work(data_root(), work_id)
    if cur.work_id == "" {
        return "作品不存在"
    }
    var rest str = cur.asset_refs
    if rest == "[]" {
        rest = ""
    }
    var total int = 0
    var remote int = 0
    var localc int = 0
    var missing int = 0
    var guard int = 0
    while guard < 64 {
        guard = guard + 1
        var line str = ""
        let nl int = rest.find("\n")
        if nl < 0 {
            line = rest
            rest = ""
        } else {
            line = rest.slice(0, nl)
            rest = rest.slice(nl + 1, rest.len())
        }
        if line != "" {
            total = total + 1
            let refv str = json_field_str(line, "storage_ref")
            if refv == "" {
                missing = missing + 1
            } else {
                if refv.find("://") >= 0 {
                    remote = remote + 1
                } else {
                    localc = localc + 1
                }
            }
        }
        if rest == "" {
            break
        }
    }
    if total == 0 {
        return "无图片资产"
    }
    var out str = "图片资产 " + total.to_string() + " 项"
    if remote > 0 {
        out = out + " · 远程 " + remote.to_string() + "（断网时显示断图）"
    }
    if localc > 0 {
        out = out + " · 本地 " + localc.to_string() + "（浏览器预览不可解析，导出时打包）"
    }
    if missing > 0 {
        out = out + " · 缺失 " + missing.to_string() + "（引用为空）"
    }
    return out
}
