# Override parent .gitignore so the vue reference prototype + test manifest commit.
# Repo-root rules `examples/**/vue/` and `*.json` would swallow vue-ref/ and
# tests/package.json (cf. 018-book-reader/.gitignore).
!vue-ref/
!tests/package.json

# Generated / runtime artifacts (still ignored).
gen/
.auto/
dist/
build/
examples/
.am/
tests/node_modules/
tests/test-results/
tests/playwright-report/

# Independent app generated/runtime artifacts
.am/
am.at
gen/
node_modules/
target/
rust-workspace/
dist/
__pycache__/
*.pyc
*.log
*.exe
*.pdb
/tmp/
/test-results/
/playwright-report/

# BLOG-001 runtime/test artifacts
.tmp/
deps/

0179*

