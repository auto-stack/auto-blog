name: "realworld"
version: "1.0.0"
scene: "ui"
render: "vue"
title: "Blog"
title_zh: "博客"
api: "rust"
front_port: 17826
back_port: 17827

dep stylekit {
    path: "vendor/stylekit"
}

# PLAN-056 T-03（auto-os/PLAN-056 主合同反链见 README）：官方主题包正式
# 接入——`vendor/themes` 为 UI 管理渠道发布的**固定版本快照**（themes 0.2.0，
# 内容 digest 9fa07742dc68aa5377ae06cb2d966386002063f184c515b6c5dddf8a6bef838e，
# 与源包逐文件 sha256 校验等价；不可二次编辑、非第二权威源）。theme 键保持
# 缺省 = follow 语义（宿主策略完整快照 > 本 design 默认 > legacy 回退）。
# 本仓无显式 theme 键（历史即缺省）。
dep themes {
    path: "vendor/themes"
}

// BLOG-002 T-01：Markdown 编辑/预览引擎（vendor 固定副本，pin 见 vendor/auto-down/PROVENANCE.md）。
// BLOG-005 T-00：引擎浏览器链 CJS 依赖显式声明——vite dev 的引擎源链（F-2）
// 需要这些包根可解析+optimizeDeps.include 才能完成 CJS 互操作（mermaid→dayjs、
// lowlight→highlight.js、katex）；配置发射半边为 auto-ui owner 前置，
// 证据见 docs/plans/evidence/005/startup-decision.md。
npm_deps: {
    "@autodown/engine": "file:../../../vendor/auto-down/autodown/packages/engine",
    "mermaid": "^11.17.2",
    "lowlight": "^3.3.0",
    "katex": "^0.16.0"
}
desktop: "true"
