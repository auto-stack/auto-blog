// persist_probe9.at — fs.file_size / file.size 双轨名位。
fn main() {
    let base str = ".tmp/probe-data"
    fs.create_dir(base)
    let p str = base + "/probe-sz.txt"
    fs.write_text(p, "12345")
    print("fs.file_size=" + fs.file_size(p).to_string())
    print("file.size=" + file.size(p).to_string())
    print("fs.is_dir=" + fs.is_dir(base).to_string())
    print("fs.is_dir_file=" + fs.is_dir(p).to_string())
    print("DONE")
}
